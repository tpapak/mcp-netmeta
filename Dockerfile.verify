# NetMeta Verify MCP Server Dockerfile
# Build: docker build -f Dockerfile.verify -t netmeta-verify-mcp .
# Run:   docker run -p 8001:8001 netmeta-verify-mcp

FROM rocker/r-ver:4.3.2

LABEL maintainer="Thodoris Papakonstantinou"
LABEL description="MCP server for NMA verification and R code generation"
LABEL org.opencontainers.image.source="https://github.com/tpapak/mcp-netmeta"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libgit2-dev \
    libnlopt-dev \
    libglpk-dev \
    cmake \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Core R packages
RUN R -e "install.packages(c('jsonlite', 'remotes'), repos='https://cloud.r-project.org/')"

# igraph (required by multiarmvars)
RUN R -e "install.packages('igraph', repos='https://cloud.r-project.org/')"

# lme4 / meta / metafor (netmeta deps)
RUN R -e "install.packages(c('lme4', 'xml2'), repos='https://cloud.r-project.org/', dependencies=TRUE)"
RUN R -e "install.packages(c('metafor', 'meta'), repos='https://cloud.r-project.org/', dependencies=TRUE)" && \
    R -e "if (!requireNamespace('meta', quietly=TRUE)) stop('meta installation failed')"

# netmeta from pinned commit
ARG NETMETA_COMMIT=5ecfc1d7739c3df360a694d60af0563bc43d68ea
RUN R -e "remotes::install_github('guido-s/netmeta@${NETMETA_COMMIT}', dependencies=FALSE)" && \
    R -e "if (!requireNamespace('netmeta', quietly=TRUE)) stop('netmeta installation failed')"

# multiarmvars (required for multi-arm variance recovery in verifiers)
RUN R -e "remotes::install_github('tpapak/multiarmvars')" && \
    R -e "if (!requireNamespace('multiarmvars', quietly=TRUE)) stop('multiarmvars installation failed')"

# Non-root user
RUN useradd -m -s /bin/bash -u 1000 netmeta

WORKDIR /app

# Python virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip

# Clone the mcp/verifier R scripts from the mcp repo
# They live at /opt/mcp/verifier inside the image
ARG MCP_REPO=https://github.com/tpapak/mcp
ARG MCP_BRANCH=main
RUN git clone --depth 1 --branch ${MCP_BRANCH} ${MCP_REPO} /opt/mcp

# Copy project
COPY pyproject.toml .
COPY src/ src/
COPY README.md .

# Install Python package with HTTP dependencies
RUN pip install ".[http]"

RUN chown -R netmeta:netmeta /app /opt/venv
USER netmeta

EXPOSE 8001

ENV PYTHONUNBUFFERED=1
ENV VERIFIERS_DIR=/opt/mcp/verifier

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/mcp || exit 1

CMD ["python", "-m", "netmeta_verify.http_server"]
